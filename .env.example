# Azure OpenAI connection. Copy to .env and fill in your own values.
# .env is gitignored; never commit a key.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-10-21
# The reasoning profile used for the published evaluation. Reasoning models are
# called through the Azure v1 endpoint, which ignores API_VERSION.
AZURE_OPENAI_MODEL=gpt-5-mini
HARDENER_REASONING_EFFORT=low
HARDENER_MAX_COMPLETION_TOKENS=16384
